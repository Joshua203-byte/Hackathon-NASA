# Cloudflare Pages. Los JS/CSS de Vite llevan hash: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Los datos se reemplazan en cada entrega del motor: caché corta.
/data/*
  Cache-Control: public, max-age=300
/geo/*
  Cache-Control: public, max-age=86400
# Teselas de la Tierra y catálogo de estrellas: no cambian entre entregas de datos.
/earth/*
  Cache-Control: public, max-age=604800
/sky/*
  Cache-Control: public, max-age=604800
/earth-night/*
  Cache-Control: public, max-age=604800
